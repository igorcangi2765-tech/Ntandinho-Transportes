# Porta onde o servidor Node.js irá rodar (definida pelo Hostinger Node App ou 5000)
PORT=5000
NODE_ENV=production

# Chaves secretas JWT para autenticação segura no ERP (Gere chaves longas e aleatórias em produção!)
JWT_SECRET=ntandinho_prod_jwt_secret_981273918273981273981273
JWT_REFRESH_SECRET=ntandinho_prod_jwt_refresh_secret_019283019283019283

# OPTION A: HOSTINGER MYSQL / MARIADB DATABASE (Recomendado para Hostinger Shared/Cloud/VPS)
# Formato: mysql://UTILIZADOR:PALAVRA_PASSE@localhost:3306/NOME_DA_BASE_DE_DADOS
# Exemplo:
# DATABASE_URL="mysql://u123456789_ntandinho:SuaSenhaSegura2026!@localhost:3306/u123456789_ntandinho_db"

# OPTION B: SQLITE DATABASE (Sem necessidade de criar utilizadores no MySQL)
DATABASE_URL="file:./prod.db"
