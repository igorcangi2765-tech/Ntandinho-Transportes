# ==============================================================================
# TRANSPORTES N' TANDINHO ERP — VARIÁVEIS DE AMBIENTE (EXEMPLO DE PRODUÇÃO)
# ==============================================================================

# Node / Environment
NODE_ENV=production
PORT=5000
APP_URL=https://ntandinho.co.mz
API_URL=https://api.ntandinho.co.mz

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/ntandinho_erp_db?schema=public"

# Security & Authentication Secrets
JWT_SECRET=substituir_por_um_jwt_secret_forte_e_aleatorio_em_producao
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=substituir_por_um_refresh_token_secret_forte
BCRYPT_SALT_ROUNDS=12

# CORS Allowed Origins (Domínio do Frontend Admin e Website Público)
CORS_ORIGIN="https://ntandinho.co.mz,https://admin.ntandinho.co.mz,http://localhost:3000"

# Hostinger Specific Config
HOSTINGER_DEPLOYMENT=true
