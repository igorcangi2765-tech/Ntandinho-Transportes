# ====================================================================
# CONFIGURAÇÃO DE REWRITE E SEGURANÇA PARA HOSTINGER
# Website N' Tandinho Transportes S.A. + Painel ERP Admin + PHP 8.3 API
# ====================================================================

# 1. Desativar Phusion Passenger / Node.js no domínio (API é PHP 8.3 nativa)
<IfModule mod_passenger.c>
    PassengerEnabled off
</IfModule>

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2. Redirecionar HTTP para HTTPS (Hostinger SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. ROTEAMENTO DA API PHP 8.3 (/api e /api/*) - FORÇAR PARA api/index.php
  # Todas as requisições sob /api e /api/* são entregues diretamente ao PHP index.php
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 4. Ignorar ficheiros e diretórios reais existentes (imagens, css, js, uploads)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Roteamento do Painel Admin ERP (/admin e /admin/*) para /admin/index.html
  RewriteRule ^admin(/.*)?$ /admin/index.html [L]

  # 6. Fallback do Site Público para index.html
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>

# ====================================================================
# CABEÇALHOS DE SEGURANÇA E CACHING
# ====================================================================
<IfModule mod_headers.c>
  # Prevenção de Clickjacking e Sniffing de MIME
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Caching de Ficheiros Estáticos
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Não armazenar em cache as páginas HTML para garantir atualizações imediatas
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
