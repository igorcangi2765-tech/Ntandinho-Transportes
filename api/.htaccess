# ====================================================================
# CONFIGURAÇÃO DE ROTEAMENTO REWRITE PARA A API PHP 8.3 (HOSTINGER)
# ERP N'Tandinho Transportes S.A.
# ====================================================================

# 1. Desativar Phusion Passenger / Node.js da Hostinger se tiver sido ativado no hPanel
<IfModule mod_passenger.c>
    PassengerEnabled off
</IfModule>

# 2. Bloquear acesso HTTP direto a ficheiros sensíveis (.env, .sql, .git, etc.)
<FilesMatch "^\.env|\.sql|\.git">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Definir index.php como o único ficheiro de índice do diretório API
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Passar o cabeçalho Authorization Bearer para a variável $_SERVER['HTTP_AUTHORIZATION']
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Encaminhar TODAS as requisições /api/* incondicionalmente para index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
