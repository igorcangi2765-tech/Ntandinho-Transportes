{
  "name": "ntandinho-transportes-erp",
  "version": "1.0.0",
  "private": true,
  "description": "N' Tandinho Transportes ERP + Website + API Backend",
  "scripts": {
    "dev": "npm --prefix admin run dev",
    "dev:public": "npx serve -p 8080 .",
    "dev:admin": "npm --prefix admin run dev",
    "dev:api": "npm --prefix api run dev",
    "preview:public": "npx serve -p 8080 .",
    "preview:admin": "npm --prefix admin run preview",
    "start": "npm --prefix api run start",
    "build:api": "npm --prefix api run build",
    "build:admin": "npm --prefix admin run build",
    "build": "npm run build:api && npm run build:admin",
    "package": "node scripts/package_production.js",
    "deploy:prepare": "npm run build && npm run package",
    "seed": "npm --prefix api run seed"
  }
}
